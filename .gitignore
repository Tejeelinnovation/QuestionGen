# ============================================================
# Question Generation System — .gitignore
# Covers: Python/Django, Node/React (frontend, future), editors
# ============================================================

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
eggs/
.eggs/
parts/
var/
sdist/
develop-eggs/
.installed.cfg
lib/
lib64/
MANIFEST

# Virtual environments
.venv/
venv/
env/
ENV/
.python-version

# pip
pip-log.txt
pip-delete-this-directory.txt

# ---- Django ----
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal
media/
staticfiles/
*_data.json
db_backup.json

# Environment variables — NEVER commit secrets
.env
.env.local
.env.*.local

# ---- Testing ----
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
*.cover
*.py,cover
htmlcov/
.pytest_cache/
nosetests.xml

# ---- MyPy / Type checking ----
.mypy_cache/
.dmypy.json
dmypy.json

# ---- Node / React (future frontend) ----
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm
.yarn/

# Frontend build output
frontend/dist/
frontend/build/
frontend/.next/
frontend/out/

# ---- Editors ----
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ---- Docker (future) ----
docker-compose.override.yml
