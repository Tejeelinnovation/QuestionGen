# ============================================================
# Question Generation System — Environment Variable Reference
# ============================================================
# Copy this file to .env and fill in your local values.
#
#   cp .env.example .env
#
# NEVER commit the .env file to version control.
# ============================================================


# ------------------------------------------------------------
# Django core
# ------------------------------------------------------------

# Generate a new key with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here

# Set to True for local development only. Always False in production.
DEBUG=True

# Comma-separated list of host/domain names Django can serve.
# Examples: localhost,127.0.0.1,yourdomain.com
ALLOWED_HOSTS=localhost,127.0.0.1


# ------------------------------------------------------------
# Database — PostgreSQL (via DATABASE_URL)
# Format: postgres://USER:PASSWORD@HOST:PORT/DB_NAME
#
# ============================================================
# HOW TO SWITCH DATABASES & SYNC DATA (STEP-BY-STEP)
# ============================================================
#
# ------------------------------------------------------------
# SCENARIO 1: SWITCH FROM NEON (CLOUD) TO LOCAL (FOR FAST CODING)
# ------------------------------------------------------------
# Step 1: While connected to Neon, export all Neon data:
#         python -X utf8 manage.py dumpdata --natural-foreign --natural-primary -e contenttypes -e auth.Permission --indent 2 -o neon_data.json
#
# Step 2: Switch DATABASE_URL below to your Local database URL.
#
# Step 3: Run migrations, flush old local rows (if any), and import the data:
#         python manage.py migrate
#         python manage.py flush --no-input   # (Clean slate to prevent duplicate key errors)
#         python manage.py loaddata neon_data.json
#
# ------------------------------------------------------------
# SCENARIO 2: SWITCH FROM LOCAL TO NEON (CLOUD DEPLOYMENT / SYNC)
# ------------------------------------------------------------
# Step 1: While connected to Local, export your new Local data:
#         python -X utf8 manage.py dumpdata --natural-foreign --natural-primary -e contenttypes -e auth.Permission --indent 2 -o local_data.json
#
# Step 2: Switch DATABASE_URL below to your Neon cloud URL.
#
# Step 3: Apply migrations and import the data into Neon:
#         python manage.py migrate
#         python manage.py loaddata local_data.json
#
# ============================================================

# --- Option A: Fast Local PostgreSQL (0ms latency, active development) ---
DATABASE_URL=postgres://qgs_user:qgs_password@localhost:5432/question_generation_system

# --- Option B: Neon Cloud PostgreSQL (free tier, cloud staging / live demo) ---
# DATABASE_URL=postgresql://neondb_owner:yourpassword@ep-cool-fog-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
 
 
# ------------------------------------------------------------
# Question Generation Service
# Options: "seeded_bank" (default, pre-seeded curriculum bank)
# Future:  "llm_rag" (LLM/RAG generation backend)
# ------------------------------------------------------------
GENERATION_SERVICE_BACKEND=seeded_bank

